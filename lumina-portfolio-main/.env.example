# Lumina Portfolio - Environment Configuration
# Copy this file to .env to customize application settings
# All values shown are the defaults - only set variables you want to override

# ============================================================================
# ANIMATION CONFIGURATION
# ============================================================================

# Animation Durations (in seconds)
# VITE_JPALAN_ANIMATION_DEFAULT_DURATION=0.6
# VITE_JPALAN_ANIMATION_SHORT_DURATION=0.25
# VITE_JPALAN_ANIMATION_MEDIUM_DURATION=0.5
