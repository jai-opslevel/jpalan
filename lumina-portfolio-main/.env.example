# Portfolio Configuration
# Copy this file to .env.local to override default values

# Toast Configuration
VITE_TOAST_LIMIT=1
VITE_TOAST_REMOVE_DELAY=1000000

# Mobile Breakpoint (pixels)
VITE_MOBILE_BREAKPOINT=768

# Sidebar Configuration
VITE_SIDEBAR_COOKIE_NAME=sidebar:state
VITE_SIDEBAR_COOKIE_MAX_AGE=604800
VITE_SIDEBAR_WIDTH=16rem
VITE_SIDEBAR_WIDTH_MOBILE=18rem
VITE_SIDEBAR_WIDTH_ICON=3rem
VITE_SIDEBAR_KEYBOARD_SHORTCUT=b

# Tooltip Configuration
VITE_TOOLTIP_DELAY_DURATION=0

# Custom Cursor Configuration
VITE_CURSOR_DAMPING=25
VITE_CURSOR_STIFFNESS=400
VITE_CURSOR_GLOW_DAMPING=50
VITE_CURSOR_GLOW_STIFFNESS=200
VITE_CURSOR_SIZE_DEFAULT=12
VITE_CURSOR_SIZE_CLICKING=8
VITE_CURSOR_SIZE_HOVERING=48
VITE_CURSOR_GLOW_SIZE_DEFAULT=120
VITE_CURSOR_GLOW_SIZE_HOVERING=200
VITE_CURSOR_OPACITY_DEFAULT=1
VITE_CURSOR_OPACITY_HOVERING=0.8
VITE_CURSOR_GLOW_OPACITY_DEFAULT=0.4
VITE_CURSOR_GLOW_OPACITY_HOVERING=0.8
VITE_CURSOR_TRANSITION_DAMPING=20
VITE_CURSOR_TRANSITION_STIFFNESS=300
VITE_CURSOR_GLOW_TRANSITION_DAMPING=30
VITE_CURSOR_GLOW_TRANSITION_STIFFNESS=150

# Magnetic Button Configuration
VITE_MAGNETIC_BUTTON_STRENGTH=0.3
VITE_MAGNETIC_BUTTON_STIFFNESS=350
VITE_MAGNETIC_BUTTON_DAMPING=15

# Animation Configuration
VITE_ANIMATION_DURATION_SHORT=0.4
VITE_ANIMATION_DURATION_MEDIUM=0.6
VITE_ANIMATION_DURATION_LONG=0.8
VITE_ANIMATION_DURATION_VERY_LONG=10
VITE_ANIMATION_DELAY_NONE=0
VITE_ANIMATION_DELAY_SHORT=0.1
VITE_ANIMATION_DELAY_MEDIUM=0.2
VITE_ANIMATION_DELAY_LONG=0.3
VITE_ANIMATION_STAGGER_FAST=0.03
VITE_ANIMATION_STAGGER_MEDIUM=0.1
VITE_ANIMATION_STAGGER_SLOW=0.15

# Server Configuration (Vite dev server)
VITE_SERVER_HOST=::
VITE_SERVER_PORT=8080
VITE_HMR_OVERLAY=false
