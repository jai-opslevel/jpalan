# VITE_JPALAN_ANIMATION_VERY_LONG_DURATION=10
# VITE_JPALAN_ANIMATION_EXTRA_LONG_DURATION=12
# VITE_JPALAN_ANIMATION_SKILLS_DURATION=0.4

# Animation Delays (in seconds)
